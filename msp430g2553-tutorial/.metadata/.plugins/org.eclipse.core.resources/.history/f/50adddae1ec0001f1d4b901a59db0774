#pragma vector=TIMER1_A1_VECTOR
__interrupt void Timer_A1(void)
{
  int a;
  switch(TA1IV)
  {
  case  TA1IV_TACCR1: break;                      // CCR1 not used
  case  TA1IV_TACCR2:                             // CCR2
	    a = TA1CCR2;                                 //-----启用中断服务函数-----
	    P1OUT ^= BIT0;                            // capture indicate
        break;
  case TA1IV_TAIFG: break;
  default :  break;
  }
}

/******************************************************************************************************
 * 名       称：WDT_init()
 * 功       能：初始化WDT定时中断为16ms
 * 入口参数：无
 * 出口参数：无
 * 说       明：无
 * 范       例：无
 ******************************************************************************************************/
void WDT_init()
{
	//-----设定WDT为-----------
	WDTCTL=WDT_ADLY_16;
	//-----WDT中断使能----------------------
    IE1 |= WDTIE;
}
