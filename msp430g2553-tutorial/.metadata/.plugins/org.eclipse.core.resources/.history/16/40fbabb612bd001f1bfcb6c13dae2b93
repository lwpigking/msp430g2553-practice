#include <msp430.h> 

/*
 * main.c
 */
int main(void) {
    WDTCTL = WDTPW | WDTHOLD;	// Stop watchdog timer
	
    // 配置DCO为1MHZ
    DCOCTL = CALDCO_1MHZ;
    BCSCTL1 = CALBC1_1MHZ;
    // 配置SMCLK的时钟源为DCO
    BCSCTL2 &= ~SELS;
    // SMCLK的分频系数
    BCSCTL2 &= ~(DIVS0 | DIVS1);

    // 复位USCI_Ax
    UCA0CTL1 |= UCSWRST;

    // 选择USCI_Ax为UART模式
    UCA0CTL0 &= ~UCSYNC;

    // 配置UART时钟源为SMCLK
    UCA0CTL1 |= UCSSEL1;




    return 0;
}
