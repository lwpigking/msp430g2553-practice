#include <msp430.h> 

/*
 * main.c
 */
int main(void) {
    WDTCTL = WDTPW | WDTHOLD;	// Stop watchdog timer
	unsigned int cnt = 0;

	DCOCTL = CALDCO_1MHZ;
	BCSCTL1 = CALBC1_1MHZ;

	P1DIR &= ~BIT6;

	TA1CTL |= TASSEL1;
	TA1CTL |= MC0|MC1;
	TA1CCRO = 0x00FF;
	TA1CCR2 = 0x00FF;

	// 设置比较模式
	TA1CCTL0 &= ~CAP;
	
	return 0;
}
