#include <msp430.h> 

/**
 * 初始化系统时钟
 */
void InitSystemClock(void) {
	// 配置DCO为1MHZ
	DCOCTL = CALDCO_1MHZ;
    BCSCTL1 = CALBC1_1MHZ;
    // 配置SMCLK的时钟源为DCO
    BCSCTL2 &= ~SELS;
    // SMCLK的分频系数
    BCSCTL2 &= ~(DIVS0 | DIVS1);
}
int main(void) {
    WDTCTL = WDTPW | WDTHOLD;	// Stop watchdog timer
	
	return 0;
}
