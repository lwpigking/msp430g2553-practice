#include <msp430.h> 

/*
 * main.c
 */
int main(void) {
    WDTCTL = WDTPW | WDTHOLD;	// Stop watchdog timer

    // 设置MCLK频率
    DCOCTL = CALDCO_16MHZ;
    BCSCTL1 = CALBC1_16MHZ;


    P1DIR |= BIT6;
	// P1.6 低电平灭
	P1OUT &= ~BIT6;

	while(1) {
		P1OUT ^= BIT6;
		__delay_cycles(500000)
	}

	return 0;
}
