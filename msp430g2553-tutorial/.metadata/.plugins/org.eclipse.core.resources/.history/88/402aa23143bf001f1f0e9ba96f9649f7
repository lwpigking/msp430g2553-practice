#include <msp430.h> 
#include <stdint.h>


/*
 * main.c
 */
int main(void) {
    WDTCTL = WDTPW | WDTHOLD;	// Stop watchdog timer

    uint8_t cnt = 0;

    DCOCTL = CALDCO_1MHZ;
    BCSCTL1 = CALBC1_1MHZ;

    P1DIR |= BIT6;

    // 1. 设置时钟源为SMCLK
    TA1CTL |= TASSEL_2;
    // 2. 设置计数模式
    TA1CTL |= MC_1;
    // 1MHZ要计5万个数
    // 耗费时间： 1/1MHZ * 50000
    // TAR 从0到TACCRO，即定时器计TACCRO + 1个数
    TA1CCR0 = 49999;

    while(1) {
    	if(TA1CTL & TAIFG) {
    		cnt++;
    		TA1CTL &= ~TAIFG;
    		if(cnt == 20) {
    			P1OUT ^= BIT6;
    			cnt = 0;
    		}
    	}
    }

    return 0;
}
